<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/background"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bw_card"
    android:paddingStart="9dp"
    android:paddingTop="9dp"
    android:paddingEnd="12dp"
    android:paddingBottom="12dp"
    android:theme="@style/Theme.Widget.Baaja">
    <ImageView android:id="@+id/widget_compact_album_art" android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="centerCrop" android:src="@mipmap/ic_launcher" android:contentDescription="@string/album_art" />
    <FrameLayout android:id="@+id/widget_compact_play_container" android:layout_width="48dp" android:layout_height="48dp" android:layout_gravity="bottom|center_horizontal" android:layout_marginBottom="8dp" android:background="@drawable/bw_circle_purple">
        <ImageView android:id="@+id/widget_compact_play_pause" android:layout_width="24dp" android:layout_height="24dp" android:layout_gravity="center" android:src="@drawable/ic_bw_play_on" android:contentDescription="@string/play_pause" />
    </FrameLayout>
</FrameLayout>
