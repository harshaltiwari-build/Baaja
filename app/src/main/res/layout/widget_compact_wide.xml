<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/background"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="horizontal"
    android:background="@drawable/bw_card"
    android:paddingStart="12dp"
    android:paddingEnd="12dp"
    android:paddingTop="9dp"
    android:paddingBottom="12dp"
    android:gravity="center_vertical"
    android:theme="@style/Theme.Widget.Baaja">
    <ImageView android:id="@+id/widget_wide_album_art" android:layout_width="44dp" android:layout_height="44dp" android:scaleType="centerCrop" android:src="@mipmap/ic_launcher" android:contentDescription="@string/album_art" />
    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="10dp" android:orientation="vertical">
        <TextView android:id="@+id/widget_wide_song_title" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/not_playing" android:textSize="14sp" android:textStyle="bold" android:textColor="@color/bw_ink" android:maxLines="1" android:ellipsize="end" />
        <TextView android:id="@+id/widget_wide_artist_name" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/tap_to_play" android:textSize="12sp" android:textColor="@color/bw_muted" android:maxLines="1" android:ellipsize="end" />
    </LinearLayout>
    <ImageButton android:id="@+id/widget_wide_like_button" android:layout_width="36dp" android:layout_height="36dp" android:padding="7dp" android:scaleType="fitCenter" android:background="@android:color/transparent" android:src="@drawable/ic_bw_heart" android:contentDescription="@string/like" />
    <FrameLayout android:id="@+id/widget_wide_play_container" android:layout_width="40dp" android:layout_height="40dp" android:layout_marginStart="4dp" android:background="@drawable/bw_circle_purple">
        <ImageView android:id="@+id/widget_wide_play_pause" android:layout_width="20dp" android:layout_height="20dp" android:layout_gravity="center" android:src="@drawable/ic_bw_play_on" android:contentDescription="@string/play_pause" />
    </FrameLayout>
</LinearLayout>
