<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/background"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="horizontal"
    android:background="@drawable/bw_card_yellow"
    android:paddingStart="12dp"
    android:paddingEnd="15dp"
    android:paddingTop="9dp"
    android:paddingBottom="12dp"
    android:gravity="center_vertical"
    android:theme="@style/Theme.Widget.Baaja">
    <ImageView android:id="@+id/bw_resume_art" android:layout_width="48dp" android:layout_height="48dp" android:scaleType="centerCrop" android:src="@mipmap/ic_launcher" android:contentDescription="@string/album_art" />
    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="10dp" android:orientation="vertical">
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/bw_continue" android:textSize="10sp" android:textStyle="bold" android:textColor="@color/bw_on_yellow" android:alpha="0.7" android:maxLines="1" />
        <TextView android:id="@+id/bw_resume_title" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/not_playing" android:textSize="15sp" android:textStyle="bold" android:textColor="@color/bw_on_yellow" android:maxLines="1" android:ellipsize="end" />
        <TextView android:id="@+id/bw_resume_sub" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/tap_to_play" android:textSize="12sp" android:textColor="@color/bw_on_yellow" android:alpha="0.75" android:maxLines="1" android:ellipsize="end" />
    </LinearLayout>
    <FrameLayout android:id="@+id/bw_resume_play" android:layout_width="44dp" android:layout_height="44dp" android:background="@drawable/bw_circle_purple">
        <ImageView android:id="@+id/bw_resume_play_icon" android:layout_width="22dp" android:layout_height="22dp" android:layout_gravity="center" android:src="@drawable/ic_bw_play_on" android:contentDescription="@string/play_pause" />
    </FrameLayout>
</LinearLayout>
