<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/background"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/bw_card"
    android:paddingStart="12dp"
    android:paddingTop="10dp"
    android:paddingEnd="15dp"
    android:paddingBottom="13dp"
    android:theme="@style/Theme.Widget.Baaja">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="@string/bw_next_alarm" android:textSize="10sp" android:textStyle="bold" android:textColor="@color/bw_muted" />
        <ImageView android:layout_width="16dp" android:layout_height="16dp" android:src="@drawable/ic_bw_alarm" android:contentDescription="@null" />
    </LinearLayout>
    <TextView android:id="@+id/bw_alarm_time" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:text="7:00 AM" android:textSize="28sp" android:textStyle="bold" android:textColor="@color/bw_ink" android:maxLines="1" android:autoSizeTextType="uniform" android:autoSizeMinTextSize="16sp" android:autoSizeMaxTextSize="30sp" />
    <TextView android:id="@+id/bw_alarm_sub" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/bw_no_alarm" android:textSize="12sp" android:textColor="@color/bw_muted" android:maxLines="2" android:ellipsize="end" />
    <FrameLayout android:layout_width="1dp" android:layout_height="0dp" android:layout_weight="1" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
        <TextView android:id="@+id/bw_alarm_day" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="" android:textSize="12sp" android:textStyle="bold" android:textColor="@color/bw_ink" android:maxLines="1" />
        <TextView android:id="@+id/bw_alarm_toggle" android:layout_width="58dp" android:layout_height="34dp" android:gravity="center" android:text="@string/bw_on" android:textSize="13sp" android:textStyle="bold" android:textColor="@color/bw_on_purple" android:background="@drawable/bw_chip_on" />
    </LinearLayout>
</LinearLayout>
