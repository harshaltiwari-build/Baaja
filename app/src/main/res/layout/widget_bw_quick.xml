<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/background"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/bw_card"
    android:paddingStart="10dp"
    android:paddingTop="9dp"
    android:paddingEnd="13dp"
    android:paddingBottom="12dp"
    android:theme="@style/Theme.Widget.Baaja">
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginStart="2dp" android:text="@string/bw_quick_play" android:textSize="15sp" android:textStyle="bold" android:textColor="@color/bw_ink" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:layout_marginTop="4dp" android:orientation="horizontal">
        <LinearLayout android:id="@+id/bw_q_liked" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_margin="3dp" android:orientation="vertical" android:padding="9dp" android:background="@drawable/bw_tile_pink">
            <ImageView android:layout_width="20dp" android:layout_height="20dp" android:src="@drawable/ic_bw_heart" android:contentDescription="@null" />
            <FrameLayout android:layout_width="1dp" android:layout_height="0dp" android:layout_weight="1" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/bw_liked" android:textSize="14sp" android:textStyle="bold" android:textColor="@color/bw_ink" android:maxLines="1" android:ellipsize="end" />
            <TextView android:id="@+id/bw_q_liked_sub" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/bw_liked_sub" android:textSize="11sp" android:textColor="@color/bw_muted" android:maxLines="1" android:ellipsize="end" />
        </LinearLayout>
        <LinearLayout android:id="@+id/bw_q_down" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_margin="3dp" android:orientation="vertical" android:padding="9dp" android:background="@drawable/bw_tile_mint">
            <ImageView android:layout_width="20dp" android:layout_height="20dp" android:src="@drawable/ic_bw_download" android:contentDescription="@null" />
            <FrameLayout android:layout_width="1dp" android:layout_height="0dp" android:layout_weight="1" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/bw_downloads" android:textSize="14sp" android:textStyle="bold" android:textColor="@color/bw_ink" android:maxLines="1" android:ellipsize="end" />
            <TextView android:id="@+id/bw_q_down_sub" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/bw_downloads_sub" android:textSize="11sp" android:textColor="@color/bw_muted" android:maxLines="1" android:ellipsize="end" />
        </LinearLayout>
        <LinearLayout android:id="@+id/bw_q_mix" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_margin="3dp" android:orientation="vertical" android:padding="9dp" android:background="@drawable/bw_tile_lilac">
            <ImageView android:layout_width="20dp" android:layout_height="20dp" android:src="@drawable/ic_bw_shuffle" android:contentDescription="@null" />
            <FrameLayout android:layout_width="1dp" android:layout_height="0dp" android:layout_weight="1" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/bw_your_mix" android:textSize="14sp" android:textStyle="bold" android:textColor="@color/bw_ink" android:maxLines="1" android:ellipsize="end" />
            <TextView android:id="@+id/bw_q_mix_sub" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/bw_mix_sub" android:textSize="11sp" android:textColor="@color/bw_muted" android:maxLines="1" android:ellipsize="end" />
        </LinearLayout>

    </LinearLayout>
</LinearLayout>
