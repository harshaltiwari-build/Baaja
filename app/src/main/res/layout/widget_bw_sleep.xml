<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/background"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/bw_card"
    android:paddingStart="12dp"
    android:paddingTop="10dp"
    android:paddingEnd="15dp"
    android:paddingBottom="13dp"
    android:theme="@style/Theme.Widget.Baaja">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
        <ImageView android:layout_width="16dp" android:layout_height="16dp" android:src="@drawable/ic_bw_moon" android:contentDescription="@null" />
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="6dp" android:text="@string/bw_sleep_timer" android:textSize="14sp" android:textStyle="bold" android:textColor="@color/bw_ink" />
    </LinearLayout>
    <LinearLayout android:id="@+id/bw_sleep_idle" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:orientation="vertical" android:layout_marginTop="6dp">
        <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:orientation="horizontal"><TextView android:id="@+id/bw_sleep_15" android:layout_width="0dp" android:layout_height="34dp" android:layout_weight="1" android:layout_margin="2dp" android:gravity="center" android:text="15 min" android:textSize="13sp" android:textStyle="bold" android:textColor="@color/bw_ink" android:background="@drawable/bw_chip" /><TextView android:id="@+id/bw_sleep_30" android:layout_width="0dp" android:layout_height="34dp" android:layout_weight="1" android:layout_margin="2dp" android:gravity="center" android:text="30 min" android:textSize="13sp" android:textStyle="bold" android:textColor="@color/bw_on_purple" android:background="@drawable/bw_chip_on" /></LinearLayout>
        <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:orientation="horizontal"><TextView android:id="@+id/bw_sleep_60" android:layout_width="0dp" android:layout_height="34dp" android:layout_weight="1" android:layout_margin="2dp" android:gravity="center" android:text="60 min" android:textSize="13sp" android:textStyle="bold" android:textColor="@color/bw_ink" android:background="@drawable/bw_chip" /><TextView android:id="@+id/bw_sleep_song" android:layout_width="0dp" android:layout_height="34dp" android:layout_weight="1" android:layout_margin="2dp" android:gravity="center" android:text="@string/bw_song_end" android:textSize="13sp" android:textStyle="bold" android:textColor="@color/bw_ink" android:background="@drawable/bw_chip" /></LinearLayout>
    </LinearLayout>
    <LinearLayout android:id="@+id/bw_sleep_active" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:orientation="vertical" android:gravity="center_horizontal" android:visibility="gone">
        <TextView android:id="@+id/bw_sleep_left" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="0:00" android:textSize="30sp" android:textStyle="bold" android:textColor="@color/bw_ink" />
        <TextView android:id="@+id/bw_sleep_left_label" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/bw_left" android:textSize="11sp" android:textColor="@color/bw_muted" />
        <FrameLayout android:layout_width="1dp" android:layout_height="0dp" android:layout_weight="1" />
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal"><TextView android:id="@+id/bw_sleep_add" android:layout_width="0dp" android:layout_height="34dp" android:layout_weight="1" android:layout_margin="2dp" android:gravity="center" android:text="+15" android:textSize="13sp" android:textStyle="bold" android:textColor="@color/bw_ink" android:background="@drawable/bw_chip" /><TextView android:id="@+id/bw_sleep_cancel" android:layout_width="0dp" android:layout_height="34dp" android:layout_weight="1" android:layout_margin="2dp" android:gravity="center" android:text="@string/bw_cancel" android:textSize="13sp" android:textStyle="bold" android:textColor="@color/bw_ink" android:background="@drawable/bw_chip" /></LinearLayout>
    </LinearLayout>
</LinearLayout>
