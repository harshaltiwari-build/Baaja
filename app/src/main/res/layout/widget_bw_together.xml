<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/background"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/bw_card"
    android:paddingStart="12dp"
    android:paddingTop="10dp"
    android:paddingEnd="15dp"
    android:paddingBottom="13dp"
    android:theme="@style/Theme.Widget.Baaja">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
        <TextView android:id="@+id/bw_tg_label" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="@string/bw_listen_together" android:textSize="10sp" android:textStyle="bold" android:textColor="@color/bw_muted" />
        <ImageView android:layout_width="16dp" android:layout_height="16dp" android:src="@drawable/ic_bw_people" android:contentDescription="@null" />
    </LinearLayout>
    <TextView android:id="@+id/bw_tg_code" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:text="@string/bw_same_song" android:textSize="15sp" android:textStyle="bold" android:textColor="@color/bw_ink" android:maxLines="2" android:ellipsize="end" />
    <TextView android:id="@+id/bw_tg_sub" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/bw_start_hint" android:textSize="12sp" android:textColor="@color/bw_muted" android:maxLines="2" android:ellipsize="end" />
    <FrameLayout android:layout_width="1dp" android:layout_height="0dp" android:layout_weight="1" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
        <TextView android:id="@+id/bw_tg_share" android:layout_width="0dp" android:layout_height="36dp" android:layout_weight="1" android:layout_marginEnd="3dp" android:gravity="center" android:text="@string/bw_share" android:textSize="13sp" android:textStyle="bold" android:textColor="@color/bw_ink" android:background="@drawable/bw_chip" android:visibility="gone" />
        <TextView android:id="@+id/bw_tg_main" android:layout_width="0dp" android:layout_height="36dp" android:layout_weight="1" android:layout_marginStart="3dp" android:gravity="center" android:text="@string/bw_start_room" android:textSize="13sp" android:textStyle="bold" android:textColor="@color/bw_on_purple" android:background="@drawable/bw_chip_on" />
    </LinearLayout>
</LinearLayout>
