<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/background"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="horizontal"
    android:background="@drawable/bw_card"
    android:paddingStart="10dp"
    android:paddingEnd="13dp"
    android:paddingTop="8dp"
    android:paddingBottom="11dp"
    android:gravity="center_vertical"
    android:theme="@style/Theme.Widget.Baaja">
    <TextView android:id="@+id/bw_search_pill" android:layout_width="0dp" android:layout_height="40dp" android:layout_weight="1" android:gravity="center_vertical" android:paddingStart="14dp" android:text="@string/bw_search_hint" android:textSize="14sp" android:textColor="@color/bw_muted" android:maxLines="1" android:ellipsize="end" android:background="@drawable/bw_chip" android:drawableStart="@drawable/ic_bw_search" android:drawablePadding="8dp" />
    <FrameLayout android:id="@+id/bw_search_mic" android:layout_width="40dp" android:layout_height="40dp" android:layout_marginStart="8dp" android:background="@drawable/bw_circle_purple">
        <ImageView android:layout_width="20dp" android:layout_height="20dp" android:layout_gravity="center" android:src="@drawable/ic_bw_mic" android:contentDescription="@string/bw_identify" />
    </FrameLayout>
</LinearLayout>
